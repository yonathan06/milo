{
  "name": "@video-editor-agent/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./users": "./src/users.ts",
    "./local": "./src/local.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/db.test.ts tests/local.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "ws": "^8.18.0"
  }
}
