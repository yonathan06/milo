# Agent's WhatsApp number, including country code, digits only.
# Required when SITE_URL is a deployed origin. Empty is allowed only for local previews.
PUBLIC_WHATSAPP_NUMBER=

# Public PostHog project token (not a personal API key). Empty disables analytics.
PUBLIC_POSTHOG_KEY=
# Match your project's region: EU uses https://eu.i.posthog.com
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Canonical/alternate URL origin. Export SITE_URL when running npm run build.
# Example only; replace with the actual deployed site's origin.
SITE_URL=
