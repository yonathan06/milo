---
import Icon from './Icon.astro';
interface Props { status: string; verified: string; }
const { status, verified } = Astro.props;
---
<header class="wa-header">
  <span class="back" aria-hidden="true"><Icon name="back" size={24} /></span>
  <div class="avatar" aria-hidden="true"><Icon name="play" size={23} /></div>
  <div class="contact">
    <div class="name">Milo <span class="verified" aria-label={verified}><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="m8 0 2 1.5 2.5.1.8 2.4 2 1.5-.7 2.5.7 2.5-2 1.5-.8 2.4-2.5.1L8 16l-2-1.5-2.5-.1-.8-2.4-2-1.5L1.4 8 .7 5.5l2-1.5.8-2.4L6 1.5Z"/><path d="m4.7 8 2.1 2.1 4.4-4.4" fill="none" stroke="white" stroke-width="1.5"/></svg></span></div>
    <span class="status">{status}</span>
  </div>
  <div class="calls" aria-hidden="true"><Icon name="video" size={23} /><Icon name="phone" size={21} /></div>
</header>
<style>
  .wa-header { display: flex; align-items: center; flex-shrink: 0; gap: 8px; min-height: 68px; padding: 10px 14px 10px 8px; background: #f6f6f6; border-bottom: 1px solid #d9dddf; color: #111b21; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  .back, .calls { color: #008069; }
  .avatar { display: grid; place-items: center; width: 38px; height: 38px; flex-shrink: 0; border-radius: 50%; background: #dcebdc; color: #286d4d; }
  .contact { flex: 1; min-width: 0; }
  .name { display: flex; align-items: center; gap: 4px; font-size: 16px; font-weight: 600; }
  .verified { color: #1da1f2; }
  .status { color: #667781; font-size: 11px; }
  .calls { display: flex; align-items: center; gap: 18px; }
  @media (max-width: 380px) { .wa-header { gap: 5px; padding-inline: 6px; } .calls { gap: 10px; } .avatar { width: 32px; height: 32px; } }
  @media (max-height: 650px) { .wa-header { min-height: 54px; padding-block: 6px; } }
</style>
