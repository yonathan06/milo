---
import Icon from './Icon.astro';
import { languages, type Locale } from '../i18n/ui';
import { getLocaleNeutralPath, useTranslations, useTranslatedPath } from '../i18n/utils';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
const pagePath = getLocaleNeutralPath(Astro.url);
---
<details class="country-selector">
  <summary aria-label={t('footer.language')} title={t('footer.language')}>
    <Icon name="globe" size={22} />
  </summary>
  <nav class="country-options" aria-label={t('footer.language')}>
    {Object.entries(languages).map(([lang, label]) => (
      <a href={translatePath(pagePath, lang as Locale)} hreflang={lang} aria-current={locale === lang ? 'page' : undefined}>
        <span lang={lang}>{label}</span>
      </a>
    ))}
  </nav>
</details>

<style>
  .country-selector { position: absolute; z-index: 2; top: 20px; inset-inline-end: 24px; color: #315b40; font-size: 13px; }
  .country-selector summary { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: #e7eee9; cursor: pointer; list-style: none; }
  .country-selector summary::-webkit-details-marker { display: none; }
  .country-selector summary:hover, .country-selector[open] summary { background: #d8e5dc; }
  .country-selector summary:focus-visible { outline: 3px solid #247557; outline-offset: 4px; }
  .country-options { position: absolute; top: calc(100% + 8px); inset-inline-end: 0; width: 230px; padding: 6px; border: 1px solid #d8e5dc; border-radius: 16px; background: #fff; box-shadow: 0 8px 28px #193d3214; }
  .country-options a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 44px; padding: 10px 12px; border-radius: 10px; color: inherit; text-decoration: none; }
  .country-options a span:last-child { color: #66756e; font-size: 12px; }
  .country-options a:hover, .country-options a[aria-current="page"] { background: #e7eee9; }

</style>
