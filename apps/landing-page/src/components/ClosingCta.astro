---
import Icon from './Icon.astro';
interface Props { heading: string; chatUrl: string; label: string; }
const { heading, chatUrl, label } = Astro.props;
---
<section class="closing-cta" aria-labelledby="closing-heading">
  <h2 id="closing-heading">{heading}</h2>
  <a class="whatsapp-link" href={chatUrl} target="_blank" rel="noopener noreferrer">
    <Icon name="whatsapp" size={23} />
    <span>{label}</span>
  </a>
</section>

<style>
  .closing-cta { max-width: 1200px; margin-inline: auto; padding: 100px 24px; text-align: center; }
  h2 { margin: 0 0 30px; font-size: clamp(34px, 5vw, 60px); line-height: 1.15; font-weight: 500; letter-spacing: -1.5px; text-wrap: balance; }
  :global([dir='rtl']) h2 { letter-spacing: 0; line-height: 1.3; }
  .whatsapp-link { display: inline-flex; align-items: center; justify-content: center; gap: 12px; max-width: 100%; min-height: 58px; padding: 16px 25px; border-radius: 100px; background: #216c4b; color: white; font-size: 15px; font-weight: 500; text-decoration: none; transition: background 160ms ease, transform 160ms ease; }
  .whatsapp-link:hover { background: #18583c; transform: translateY(-2px); }
  .whatsapp-link:active { transform: none; }
  @media (max-width: 600px) { .closing-cta { padding-block: 72px; } .whatsapp-link { padding-inline: 20px; font-size: 14px; } }
  @media (prefers-reduced-motion: reduce) { .whatsapp-link { transition: none; } .whatsapp-link:hover { transform: none; } }
</style>
