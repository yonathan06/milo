---
import Icon from './Icon.astro';
import WhatsAppHeader from './WhatsAppHeader.astro';
import WhatsAppComposer from './WhatsAppComposer.astro';
import type { LandingCopy } from './landing-copy';
interface Props { copy: LandingCopy; }
const { copy } = Astro.props;
const clips = [
  { image: copy.media.clips[0], description: copy.clipDescriptions[0], duration: '0:18' },
  { image: copy.media.clips[1], description: copy.clipDescriptions[1], duration: '0:24' },
  { image: copy.media.clips[2], description: copy.clipDescriptions[2], duration: '0:12' },
  { image: copy.media.clips[3], description: copy.clipDescriptions[3], duration: '0:32' },
];
---
<section class="chat" aria-label={copy.chatLabel}>
  <WhatsAppHeader status={copy.online} verified={copy.verified} />

  <div class="conversation">
    <span class="day">{copy.today}</span>
    <div class="bubble sent album" aria-label={copy.sentAlbum}>
      <div class="clip-grid">
        {clips.map((clip) => (
          <div class="clip">
            <img src={clip.image} alt={clip.description} width="240" height="160" />
            <span class="clip-duration"><Icon name="video" size={13} />{clip.duration}</span>
          </div>
        ))}
      </div>
      <div class="message-meta">11:42 <span class="read-receipt" aria-label={copy.read}><Icon name="check" size={16} /></span></div>
    </div>
    <div class="bubble sent request">
      <p set:html={copy.request} />
      <div class="message-meta">11:42 <span class="read-receipt" aria-label={copy.read}><Icon name="check" size={16} /></span></div>
    </div>
    <div class="bubble received response">
      <p>{copy.response}</p>
      <div class="message-meta">11:42</div>
    </div>
    <div class="bubble received result">
      <div class="recap-preview">
        <img src={copy.media.result} alt={copy.result} width="960" height="540" />
        <span class="recap-play-icon" aria-hidden="true"><Icon name="play" size={27} /></span>
        <span class="video-length" aria-hidden="true">0:12</span>
      </div>
      <div class="recap-caption">
        <p>{copy.caption}</p>
        <div class="message-meta">11:43</div>
      </div>
    </div>
  </div>
  <WhatsAppComposer placeholder={copy.message} />
</section>

<style>
  .chat { border: 5px solid #fff; border-radius: 27px; overflow: hidden; background: #efeae2; box-shadow: 0 24px 65px -20px #264c3226, 0 3px 12px #193d3208; color: #111b21; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; transform: rotate(1deg); }
  .conversation { padding: 15px 17px 19px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; background-image: url('/chat-pattern.svg'); background-size: 280px 280px; }
  .day { align-self: center; margin-bottom: 7px; padding: 4px 11px; background: #fff9; color: #67726c; font-size: 10px; line-height: 1.4; border-radius: 6px; box-shadow: 0 1px 1px #00000008; }
  .bubble { max-width: 100%; position: relative; border-radius: 9px; box-shadow: 0 1px 1px #13271912; }
  .sent { align-self: flex-end; background: #d9fdd3; }
  .received { background: #fff; }
  .bubble p { font-size: 12px; line-height: 1.5; margin: 0; }
  .message-meta { display: flex; justify-content: flex-end; align-items: center; gap: 4px; height: 15px; font-size: 9px; line-height: 1; color: #697667; }
  .read-receipt { color: #45a9d0; }
  .album { width: 252px; padding: 4px 4px 2px; border-top-right-radius: 3px; }
  .clip-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; border-radius: 6px; overflow: hidden; }
  .clip { position: relative; height: 77px; background: #8b8e76; overflow: hidden; }
  .clip::after { content: ''; position: absolute; inset: 35% 0 0; background: linear-gradient(transparent, #0007); pointer-events: none; }
  .clip img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .clip-duration { position: absolute; z-index: 1; left: 7px; bottom: 5px; display: flex; align-items: center; gap: 4px; color: white; font-size: 9px; }
  .album .message-meta { padding-right: 3px; height: 19px; }
  .request { padding: 8px 9px 4px; border-top-right-radius: 3px; }
  .request::after { content: ''; position: absolute; top: 0; right: -6px; border-top: 8px solid #d9fdd3; border-right: 8px solid transparent; }
  .response { padding: 8px 9px 4px; margin-top: 6px; border-top-left-radius: 3px; }
  .response::before { content: ''; position: absolute; top: 0; left: -6px; border-top: 8px solid white; border-left: 8px solid transparent; }
  .result { width: 278px; padding: 4px; }
  .recap-preview { position: relative; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; background: #313c2e; }
  .recap-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .recap-play-icon { position: absolute; inset: 0; margin: auto; width: 49px; height: 49px; border-radius: 50%; background: #fffefaed; border: 1px solid #fff8; color: #315b40; display: grid; place-items: center; pointer-events: none; box-shadow: 0 3px 20px #0002; }
  .video-length { position: absolute; bottom: 8px; left: 9px; color: white; font-size: 10px; text-shadow: 0 1px 3px #000; }
  .recap-caption { padding: 7px 6px 1px; }
  .recap-caption p { font-size: 12px; }


  @media (min-width: 901px) and (max-height: 820px) {
    .conversation { padding-block: 12px 14px; gap: 6px; }
    .clip { height: 65px; }
  }
  @media (max-width: 900px) {
    .chat { width: 100%; max-width: 392px; justify-self: center; transform: none; border-width: 4px; border-radius: 24px; }
  }
  @media (max-width: 380px) {
    .conversation { padding-inline: 13px; }
    .bubble p { font-size: 11px; }
    .result { width: 258px; }
    .album { width: 236px; }
  }
</style>
