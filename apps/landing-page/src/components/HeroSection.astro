---
import Icon from './Icon.astro';
import WhatsAppPreview from './WhatsAppPreview.astro';
import type { LandingCopy } from './landing-copy';
interface Props { copy: LandingCopy; chatUrl: string; }
const { copy, chatUrl } = Astro.props;
---
<section class="hero">
<div class="intro">
  <div class="brand-mark" aria-hidden="true">
    <svg viewBox="0 0 52 52" fill="none"><path d="M37 9H15a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h4l-2 7 12-7h8a8 8 0 0 0 8-8V17a8 8 0 0 0-8-8Z" fill="currentColor"/><path d="m22 18 12 7-12 7V18Z" fill="#f4f7f5"/></svg>
  </div>
  <h1>{copy.headline.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>
  <a class="cta" href={chatUrl} target="_blank" rel="noopener noreferrer">
    <Icon name="whatsapp" size={23} />
    <span>{copy.cta}</span>
  </a>
  <slot />
</div>

  <slot name="preview"><WhatsAppPreview {copy} /></slot>
</section>

<style>
  .hero { min-height: 100svh; max-width: 1200px; margin-inline: auto; padding: 48px 36px; display: grid; grid-template-columns: minmax(0, 1fr) 392px; align-items: center; gap: 80px; }
  .intro { padding-bottom: 10px; }
  .brand-mark { width: 48px; height: 48px; margin-bottom: 32px; color: #236c4e; }
  h1 { font-size: clamp(60px, 6.35vw, 86px); line-height: 1.055; font-weight: 500; letter-spacing: -4.8px; margin: 0 0 38px; }
  :global([dir="rtl"]) h1 { letter-spacing: 0; line-height: 1.2; }
  .cta { display: inline-flex; gap: 12px; align-items: center; justify-content: center; background: #216c4b; color: white; border-radius: 100px; min-height: 58px; padding: 16px 25px; font-size: 15px; font-weight: 500; text-decoration: none; transition: background 160ms ease, transform 160ms ease; }
  .cta:hover { background: #18583c; transform: translateY(-2px); }
  .cta:active { transform: translateY(0); }

  @media (min-width: 1500px) { .hero { gap: 115px; } }
  @media (max-width: 1050px) { .hero { gap: 36px; grid-template-columns: minmax(0, 1fr) 365px; padding-inline: 40px; } h1 { font-size: 65px; letter-spacing: -3.8px; } }
  @media (min-width: 901px) and (max-height: 820px) {
    .hero { padding-block: 24px; }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 44px; padding: 48px 24px 44px; }
    .intro { padding: 0; text-align: center; }
    .brand-mark { margin: 0 auto 25px; width: 40px; height: 40px; }
    h1 { font-size: clamp(44px, 8.2vw, 68px); line-height: 1.06; letter-spacing: -2.7px; margin-bottom: 27px; }
    .cta { min-height: 54px; padding: 14px 22px; font-size: 14px; }
  }
  @media (max-width: 380px) {
    .hero { padding-inline: 16px; gap: 34px; }
    h1 { font-size: 42px; letter-spacing: -2.6px; }
  }
  @media (prefers-reduced-motion: reduce) { .cta { transition: none; } .cta:hover { transform: none; } }
</style>
