---
import LandingPage from '../components/LandingPage.astro';
import { segmentSlugs, type Segment } from '../content/segments';
export function getStaticPaths() {
  return segmentSlugs.map(segment => ({ params: { segment }, props: { segment } }));
}
interface Props { segment: Segment; }
const { segment } = Astro.props;
---
<LandingPage {segment} />
