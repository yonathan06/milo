OPENROUTER_API_KEY=
GTM_PLANNER_MODEL=deepseek/deepseek-v4.1-flash
# Optional model for query generation from the CLI or segment page.
# GTM_PLANNER_MODEL=deepseek/deepseek-v4.1-flash
# Required to execute stored queries with Brave Web Search.
BRAVE_API_KEY=
# Optional SQLite path (relative paths resolve from the working directory).
# GTM_DATABASE_PATH=./data/gtm-copilot.sqlite
# Public-web rendering; auto uses Firecrawl when this key is present, native otherwise.
FIRECRAWL_API_KEY=
# Public Facebook groups/Reddit communities via Apify. May also be exported in ~/.bashrc.
APIFY_KEY=
# Optional Actor charge ceiling per run (does not guarantee all platform costs).
# GTM_APIFY_MAX_CHARGE_USD=0.5
# Optional: auto (default), apify, firecrawl, or native.
# GTM_SCRAPE_COLLECTOR=auto
# Cheap pre-enrichment link ranking via TypeSafe (no scraping).
TYPESAFE_API_KEY=
# Pin a version so cached scores and thresholds stay comparable.
# GTM_LINK_RANKING_MODEL=jev-1.13.0
# Up to 10 links/request by default (1..20); oversized batches split automatically.
# GTM_JEV_BATCH_SIZE=10
# Concurrent batch workers (1..4), globally paced to two requests/sec per process.
# GTM_JEV_CONCURRENCY=2
# Optional extraction model (default: Gemma; uses OPENROUTER_API_KEY).
# GTM_ENRICHMENT_MODEL=google/gemma-4-31b-it
# Focused extraction budget across source documents; web sources are cleaned, JS-rendered HTML.
# GTM_EXTRACTION_MAX_SOURCE_CHARS=16000
# Compact structured output; extraction explicitly disables reasoning.
# GTM_EXTRACTION_MAX_OUTPUT_TOKENS=4096
# Extraction has no added model/stream deadline; provider and corrective retries remain enabled.
# Web pages use Playwright in auto mode. Install Chromium: pnpm --filter gtm-copilot exec playwright install chromium
# Optional custom Chromium binary (otherwise Playwright's installed Chromium).
# GTM_PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chrome
# Optional independent outreach verification model (default: DeepSeek, not the extraction model).
# GTM_VERIFICATION_MODEL=deepseek/deepseek-v4.1-flash
# Optional post-enrichment scoring/permission model (otherwise uses verification model).
# GTM_ASSESSMENT_MODEL=deepseek/deepseek-v4.1-flash
# Leave unset without approved official Reddit access; Apify uses APIFY_KEY instead.
# Only for an approved Reddit API use case; OAuth bearer token, not account cookies.
# REDDIT_ACCESS_TOKEN=
