{
  "name": "marketing-prospector",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "benchmark": "node --experimental-strip-types src/server/benchmark.mjs",
    "start": "vite preview --host 127.0.0.1",
    "reset-research": "node --experimental-strip-types src/server/reset-research.mjs",
    "restore-previous-workspace": "node --experimental-strip-types src/server/restore-workspace.mjs",
    "test": "node --experimental-strip-types --test src/server/*check.mjs && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.120.5",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.120.5",
    "@tanstack/react-table": "^8.21.3",
    "cheerio": "^1.2.0",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
