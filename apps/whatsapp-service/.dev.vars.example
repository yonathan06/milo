# Managed secrets in deployed Workers. Never commit .dev.vars.
# Local simulator defaults are in wrangler.local.jsonc; no service secrets needed.
DATABASE_URL=postgresql://USER:PASSWORD@PROJECT-pooler.REGION.neon.tech/DATABASE?sslmode=require
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-random-verification-token
