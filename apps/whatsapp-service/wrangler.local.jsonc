{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milo-whatsapp-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "assets": { "directory": "./ui", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "LOCAL_DATABASE_URL": "postgresql://milo:milo_dev@127.0.0.1:5432/milo",
    "WHATSAPP_APP_SECRET": "local-simulator-only-not-a-real-secret",
    "WHATSAPP_VERIFY_TOKEN": "local-simulator-token",
    "DISPATCH_ENABLED": "true",
    "TEST_RESPONDER_ENABLED": "false",
    "AGENT_ENABLED": "true",
    "SIMULATOR_EVENTS_ENABLED": "true",
    "ALLOW_TRYCLOUDFLARE": "true"
  },
  "services": [{ "binding": "AGENT", "service": "milo-whatsapp-agent" }],
  "durable_objects": { "bindings": [{ "name": "CONVERSATIONS", "class_name": "ConversationCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationCoordinator"] }],
  "queues": {
    "producers": [{ "binding": "PROCESSING_QUEUE", "queue": "milo-whatsapp-local-processing" }],
    "consumers": [{
      "queue": "milo-whatsapp-local-processing",
      "max_batch_size": 10,
      "max_batch_timeout": 1,
      "max_retries": 5,
      "dead_letter_queue": "milo-whatsapp-local-processing-dlq"
    }]
  },
  "triggers": { "crons": ["* * * * *"] }
}
